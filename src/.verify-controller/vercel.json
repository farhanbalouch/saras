{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "_server/**"
    }
  },
  "rewrites": [
    {
      "source": "/account/:device/",
      "destination": "/api/index?route=account/:device"
    },
    {
      "source": "/account/:device",
      "destination": "/api/index?route=account/:device"
    },
    {
      "source": "/account/:path*",
      "destination": "/api/index?route=account/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/index?route=auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/account/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/mobile/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "regions": [
    "bom1"
  ]
}
